{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    { "path": "/api/cron/reset-usage", "schedule": "0 0 1 * *" },
    { "path": "/api/cron/trial-reminders", "schedule": "0 9 * * *" },
    { "path": "/api/cron/payment-reminders", "schedule": "0 9 * * 1" }
  ]
}
